#!/usr/bin/env bash
# script/deploy — Build and deploy notes-tracker to the production host.
# Runs on your build machine.
#
# First deploy:  run script/provision-host on the host first.
# Subsequent:    just run this script — it builds, copies, and restarts.

set -euo pipefail
cd "$(dirname "$0")/.."
source script/lib/common.sh

USAGE="Usage: script/deploy [--native]

Builds the app, bundles it into dist/, rsyncs it to the deploy host
(never touching the host's data/), and restarts the 'notes' service.

Configure the target in .env (see .env.example):
  DEPLOY_USER      SSH login on the deploy host
  DEPLOY_HOST      Host IP or hostname
  DEPLOY_APP_DIR   App directory on the host (default /opt/notes/app)

  --native   Build for this machine's OS/arch instead of linux/arm64."
handle_help "$@"

# ─── Parse args ───────────────────────────────────────────────────────────────
BUILD_TARGET="build"          # 'build' = linux/arm64, 'build-native' = current arch
for arg in "$@"; do
    case $arg in
        --native) BUILD_TARGET="build-native" ;;
        *) die "Unknown argument: $arg (see --help)" ;;
    esac
done

# ─── Configuration (from .env) ────────────────────────────────────────────────
load_env
REMOTE_USER="${DEPLOY_USER:-}"
REMOTE_HOST="${DEPLOY_HOST:-}"
REMOTE_APP_DIR="${DEPLOY_APP_DIR:-/opt/notes/app}"  # Must match APP_DIR in script/provision-host

[[ -n "$REMOTE_USER" && -n "$REMOTE_HOST" ]] \
    || die "DEPLOY_USER and DEPLOY_HOST must be set in .env (see .env.example)."

# ─── Sanity checks ────────────────────────────────────────────────────────────
require_cmd rsync "Install rsync."
require_cmd ssh   "Install an SSH client."

# Check SSH connection early so we fail fast before a slow build
info "Checking SSH connection to ${REMOTE_USER}@${REMOTE_HOST}..."
ssh -o ConnectTimeout=5 -o BatchMode=yes "${REMOTE_USER}@${REMOTE_HOST}" true \
    || die "Cannot reach ${REMOTE_USER}@${REMOTE_HOST} via SSH. Check your connection."
success "SSH connection OK."

# ─── Dependencies ─────────────────────────────────────────────────────────────
script/bootstrap

# ─── Build + bundle ───────────────────────────────────────────────────────────
step "Building and bundling"
info "Target: make dist BUILD_TARGET=${BUILD_TARGET}"
make dist BUILD_TARGET="${BUILD_TARGET}"
BUNDLE_SIZE=$(du -sh dist/ | cut -f1)
success "Bundle ready (${BUNDLE_SIZE})."

# ─── Transfer ─────────────────────────────────────────────────────────────────
step "Transferring"
info "rsync → ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_APP_DIR}/"

# Exclude the runtime data directory — never overwrite live DB or uploads
rsync -az --delete \
    --exclude='data/' \
    --progress \
    dist/ "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_APP_DIR}/"

success "Transfer complete."

# ─── Restart ──────────────────────────────────────────────────────────────────
step "Restarting service"
ssh "${REMOTE_USER}@${REMOTE_HOST}" bash <<'REMOTE'
    set -e
    sudo systemctl restart notes
    sleep 1
    if sudo systemctl is-active --quiet notes; then
        echo "[ok]    Service is running."
        sudo systemctl status notes --no-pager -l | grep -E 'Active:|Main PID:|listening'
    else
        echo "[error] Service failed to start:" >&2
        sudo journalctl -u notes -n 20 --no-pager >&2
        exit 1
    fi
REMOTE

# ─── Done ─────────────────────────────────────────────────────────────────────
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "  ${GREEN}Deploy complete!${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "  Tail logs:  ssh ${REMOTE_USER}@${REMOTE_HOST} 'journalctl -u notes -f'"
echo ""
