# ── Local development ──────────────────────────────────────────────
# Copied to .env by script/bootstrap, which also generates JWT_SECRET.
JWT_SECRET=
PORT=3001
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173

# ── Deploy target (used by script/deploy and script/console production) ──
DEPLOY_USER=
DEPLOY_HOST=
DEPLOY_APP_DIR=/opt/notes/app
